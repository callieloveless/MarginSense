# MarginSense environment — copy to .env.local and fill in. NEVER commit real secrets
# (techstack §7). All secrets are server-side only.

# --- Database (Supabase Postgres) -------------------------------------------------
# Connect with a role that IS subject to Row-Level Security (not the postgres superuser
# and not the service_role), so per-business policies are enforced even if app code has
# a bug (constitution §6.3). Used by Drizzle for the data plane and by db:migrate.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres

# --- Supabase Auth ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Anthropic (AI tools; added by a later change, not the foundation) ------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Opt-in RLS test suite (npm run test:rls) -------------------------------------
# Two auth identities in two different businesses; leave unset to skip the suite.
# RLS_TEST_A_JWT=
# RLS_TEST_B_JWT=
